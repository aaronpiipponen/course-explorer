# GitHub Actions runner service for this repository's deployment job.
[Unit]
Description=course-explorer deployment runner

[Service]
WorkingDirectory=@RUNNER@
ExecStart=@RUNNER@/run.sh
Environment=HOME=@HOME@
Environment=PATH=@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
UMask=0077
Restart=on-failure

[Install]
WantedBy=default.target
